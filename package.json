{
  "name": "yaml-math-hovers",
  "displayName": "YAML Math Hovers",
  "description": "Renders LaTeX math in YAML schema descriptions shown in hovers",
  "version": "0.1.0",
  "publisher": "rjoussen",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rjoussen/vscode-yaml-math-hovers.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "yaml",
    "json schema",
    "latex",
    "math",
    "mathjax"
  ],
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:yaml-textmate",
    "onLanguage:yaml-tmlanguage",
    "onLanguage:ansible",
    "onLanguage:azure-pipelines",
    "onLanguage:dockercompose",
    "onLanguage:github-actions-workflow",
    "onLanguage:home-assistant",
    "onLanguage:manifest-yaml",
    "onLanguage:spring-boot-properties-yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "YAML Math Hovers",
      "properties": {
        "yamlMath.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Render LaTeX math in schema descriptions shown in YAML hovers. Supports `$...$` and `$$...$$`. Unsupported or oversized equations are left as source.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "format": "prettier --write .",
    "test:unit": "tsc -p ./ && mocha --ui bdd --timeout 20000 \"out/test/unit/**/*.test.js\"",
    "test:images": "tsc -p ./ && mocha --ui bdd \"out/test/images/**/*.test.js\"",
    "test:integration": "tsc -p ./ && webpack --mode development && vscode-test",
    "test": "npm run test:unit && npm run test:images && npm run test:integration",
    "package": "vsce package",
    "demo": "webpack --mode development && node scripts/record-demo.mjs",
    "test:web": "webpack --mode development && webpack --config test/web/webpack.config.js && vscode-test-web --browserType=chromium --headless --extensionDevelopmentPath=. --extensionPath=\"${VSCODE_YAML_EXTENSIONS:-test/web/extensions}\" --extensionTestsPath=out/web/index.js test/fixtures"
  },
  "dependencies": {
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "^0.19.0"
    }
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.82.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.0.0",
    "chai": "^4.5.0",
    "mocha": "^11.8.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "ts-loader": "^9.6.2",
    "typescript": "~5.8",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.1"
  }
}
